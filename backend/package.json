{
  "name": "pos-restaurante-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test:impresion": "node --import tsx --test tests-node/impresion.test.mjs",
    "test:pedidos": "node --import tsx --test tests-node/pedido-mix.test.mjs tests-node/extras.test.mjs",
    "test:turnos": "node --import tsx --test tests-node/horario.test.mjs tests-node/sesiones-tablet.test.mjs tests-node/disponibilidad-tablets.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
