# Copia este archivo como .env y cambia los valores.

# Puerto donde se abre el sistema en el navegador (http://localhost:8080)
FRONTEND_PORT=8080

# Clave para firmar las sesiones (mínimo 32 caracteres).
# Genera una con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-una-clave-larga-de-al-menos-32-caracteres
JWT_EXPIRES_IN=12h

# Usuario administrador inicial
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambia-esta-contraseña
ADMIN_NOMBRE=Administrador

# La conexion MySQL de Laravel se configura en backend/.env.
# Consulta backend/.env.example y backend/database/README.md.

# Agente de impresión (print-agent/), corre en la PC con la impresora de tickets.
# Con Docker se usa http://host.docker.internal:9101; sin Docker, http://localhost:9101.
# PRINT_AGENT_URL=http://host.docker.internal:9101
# Nombre exacto de la impresora en Windows (si no se define, se busca una térmica automáticamente).
# IMPRESORA_TICKETS=Star TSP100 Cutter (TSP143)
